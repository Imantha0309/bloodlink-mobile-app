NODE_ENV=development
PORT=4000

# Database
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bloodlink
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# CORS
CORS_ORIGIN=*

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
